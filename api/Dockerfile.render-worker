FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y \
        --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt

RUN pip install \
    --no-cache-dir \
    -r /app/requirements.txt

COPY app /app/app

RUN useradd \
      --create-home \
      --uid 10001 \
      app \
    && chown -R app:app /app

USER app

CMD ["python", "-m", "app.workers.render_worker"]
