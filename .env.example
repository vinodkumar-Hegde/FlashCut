APP_ENV=local
APP_VERSION=1.0.0
AUTH_DISABLED=true

AWS_PROFILE=dev
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

S3_BUCKET=
S3_VIDEO_PREFIX=videos/
S3_OUTPUT_PREFIX=generated/
S3_TRANSCRIPT_PREFIX=transcripts/

TRANSCRIBE_LANGUAGE=en-US
TRANSCRIBE_VOCABULARY=
TRANSCRIBE_CONFIG_VERSION=v1

BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

SUMMARY_ALGORITHM_VERSION=v3.1


RENDER_QUEUE_URL=
RENDER_PROFILE_VERSION=v1

DATABASE_URL=

RENDER_VISIBILITY_TIMEOUT_SECONDS=300
RENDER_HEARTBEAT_INTERVAL_SECONDS=60
RENDER_STALE_AFTER_SECONDS=600
RENDER_QUEUE_PUBLISH_MAX_ATTEMPTS=20

NOTES_ALGORITHM_VERSION=v1

LOCAL_TENANT_ID=local-development

# Production JWT / OIDC authentication.
# Local Docker keeps AUTH_DISABLED=true.
#
# Cognito example:
# AUTH_JWT_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/<user-pool-id>
# AUTH_JWT_AUDIENCE=<app-client-id>
# AUTH_JWKS_URL=
# AUTH_TENANT_CLAIM=custom:tenant_id
# AUTH_SUBJECT_CLAIM=sub
# AUTH_JWT_AUDIENCE_CLAIM=client_id
# AUTH_JWT_TOKEN_USE=access
# AUTH_JWT_ALGORITHMS=RS256
# AUTH_CLOCK_SKEW_SECONDS=60

# Optional production tenant isolation for source objects.
# Example:
# S3_TENANT_PREFIX_TEMPLATE=videos/tenants/{tenant_id}/
S3_TENANT_PREFIX_TEMPLATE=

# API security / distributed rate limiting.
# Production must use explicit hostnames, not "*".
# Example:
# TRUSTED_HOSTS=api.flashcut.example.com
TRUSTED_HOSTS=*

MAX_REQUEST_BYTES=2000000

# Local Compose supplies redis://production-redis:6379/0.
# Production should point this at managed Redis/ElastiCache.
RATE_LIMIT_ENABLED=false
REDIS_URL=
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_WRITE_REQUESTS_PER_MINUTE=60

# User-uploaded intro/outro assets.
S3_RENDER_ASSET_PREFIX=render-assets/
RENDER_ASSET_UPLOAD_PRESIGN_SECONDS=900
RENDER_ASSET_MAX_BYTES=104857600
RENDER_ASSET_MAX_DURATION_SECONDS=60

# Independent generation pipelines
QUICK_SUMMARY_ALGORITHM_VERSION=v1
LEARNING_MATERIAL_ALGORITHM_VERSION=v1
GENERATION_MAX_ATTEMPTS=3
GENERATION_WORKER_POLL_SECONDS=1
GENERATION_STALE_AFTER_SECONDS=1800
