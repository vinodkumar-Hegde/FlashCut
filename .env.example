APP_ENV=local
APP_VERSION=1.0.0
AUTH_DISABLED=true

AWS_PROFILE=dev
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

S3_BUCKET=
S3_VIDEO_PREFIX=videos/
S3_OUTPUT_PREFIX=generated/
S3_TRANSCRIPT_PREFIX=transcripts/

TRANSCRIBE_LANGUAGE=en-US
TRANSCRIBE_VOCABULARY=
TRANSCRIBE_CONFIG_VERSION=v1

BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

SUMMARY_ALGORITHM_VERSION=v3.1


RENDER_QUEUE_URL=
RENDER_PROFILE_VERSION=v1

DATABASE_URL=

RENDER_VISIBILITY_TIMEOUT_SECONDS=300
RENDER_HEARTBEAT_INTERVAL_SECONDS=60
RENDER_STALE_AFTER_SECONDS=600
RENDER_QUEUE_PUBLISH_MAX_ATTEMPTS=20
